    "character-card"
  ],
  "license": "GPL-3.0-only",
  "author": "Link2theWorld",
  "homepage": "https://github.com/Link2theWorld/love-letter-mailbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Link2theWorld/love-letter-mailbox.git"
  },
  "bugs": {
    "url": "https://github.com/Link2theWorld/love-letter-mailbox/issues"
  },
  "type": "module",
  "bin": {
    "love-letter-mailbox": "bin/cli.js",
    "love-letter": "bin/cli.js"
  },
  "files": [
    "bin/",
    "src/",
    "examples/",
    "sillytavern-extension/",
    "wrangler.jsonc",
    "tsconfig.json",
